{
  "name": "carina-desktop",
  "version": "0.1.0",
  "description": "Carina — local model-service proxy (desktop app)",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.carina.desktop",
    "productName": "Carina",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "carina/**/*",
      "pyproject.toml",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "carina/web/",
        "to": "carina/web/"
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "electron/icons/"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "electron/icons/",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "electron/icons/"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
